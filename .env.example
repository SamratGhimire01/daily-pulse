# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GitHub repository to push generated content to, e.g. https://github.com/yourname/daily-pulse.git
GITHUB_REPO_URL=

# Only needed for HTTPS push auth from environments without SSH keys (e.g. GitHub Actions
# uses its own built-in token, so this is mainly for local/manual pushes or other CI).
GITHUB_TOKEN=

# Git identity used for commits made by the bot
GIT_AUTHOR_NAME=DailyPulse Bot
GIT_AUTHOR_EMAIL=dailypulse-bot@users.noreply.github.com
